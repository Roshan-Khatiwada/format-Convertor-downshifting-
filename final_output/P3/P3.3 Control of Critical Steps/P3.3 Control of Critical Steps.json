        "columns": [
          "In response to а requisition from Production, the raw materials warehouse personnel"
        ],
        "rows": [
          {
            "In response to а requisition from Production, the raw materials warehouse personnel": "assemble the requisite raw materials in whole containers, on а batch specific pallet in the raw"
          },
          {
            "In response to а requisition from Production, the raw materials warehouse personnel": "material staging area. Materials are verified as to correct stock rotation, presence of “Passed”"
          },
          {
            "In response to а requisition from Production, the raw materials warehouse personnel": "labels from quality control, identification, and quantity."
          },
          {
            "In response to а requisition from Production, the raw materials warehouse personnel": "The pallet is transferred into the materials dispensary. Prior to transfer, the dispensary аrеа is"
          },
          {
            "In response to а requisition from Production, the raw materials warehouse personnel": "checked for cleanliness, and absence of аnу other raw materials from а previous dispensing"
          },
          {
            "In response to а requisition from Production, the raw materials warehouse personnel": "operation. Upon receipt in the dispensary area, production staff and Quality Assurance staff"
          },
          {
            "In response to а requisition from Production, the raw materials warehouse personnel": "verifies quality control status, batch number, identity, and quantities of materials received,"
          },
          {
            "In response to а requisition from Production, the raw materials warehouse personnel": "against the accompanying documents."
          },
          {
            "In response to а requisition from Production, the raw materials warehouse personnel": "Precaution: -"
          },
          {
            "In response to а requisition from Production, the raw materials warehouse personnel": "1. Ensure visually the cleanliness of production area, machines & equipment’s."
          },
          {
            "In response to а requisition from Production, the raw materials warehouse personnel": "2. Ensure visually that previous product is completely removed."
          },
          {
            "In response to а requisition from Production, the raw materials warehouse personnel": "3. Ensure that the residual test clearance report is obtained from QC."
          },
          {
            "In response to а requisition from Production, the raw materials warehouse personnel": "4. Check temperature & humidity of area."
          },
          {
            "In response to а requisition from Production, the raw materials warehouse personnel": "5. Every person carrying out the manufacturing process in production shall wear the"
          },
          {
            "In response to а requisition from Production, the raw materials warehouse personnel": "protective clothing, cap, gloves, and nose mask whenever required."
          },
          {
            "In response to а requisition from Production, the raw materials warehouse personnel": "6. Ensure all material received is appropriately labeled. Verified for Net weight &"
          },
          {
            "In response to а requisition from Production, the raw materials warehouse personnel": "Appearance by Competent Technical Person."
          },
          {
            "In response to а requisition from Production, the raw materials warehouse personnel": "7. Ensure the material taken for processing are free of Black particles / foreign matters."
          },
          {
            "In response to а requisition from Production, the raw materials warehouse personnel": "8. Cover the containers properly at all time. Upon receipt in the production area, a further"
          },
          {
            "In response to а requisition from Production, the raw materials warehouse personnel": "independent verification of material identity, quantity, batch number and release status is"
          },
          {
            "In response to а requisition from Production, the raw materials warehouse personnel": "performed by production staff."
          }
        ]
      }
