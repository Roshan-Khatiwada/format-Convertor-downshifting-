    {
      "type": "table",
      "section_title": "B. BRIEF DISCRIPTION OF MANUFACTURING PROCEDURE",
      "sn": 49,
      "content": {
        "columns": [
          "1.3",
          "Sift Magnesium stearate through 60# sieve & keep aside for lubrication stage."
        ],
        "rows": [
          {
            "1.3": "2. Dry Mixing:",
            "Sift Magnesium stearate through 60# sieve & keep aside for lubrication stage.": ""
          },
          {
            "1.3": "2.1.",
            "Sift Magnesium stearate through 60# sieve & keep aside for lubrication stage.": "Load the sifted materials (Solifenacin Succinate+lactose monohydrate+maize starch starch+Magnesium stearate) into the RMG. Dry mix the material for 10 minutes at impeller slow speed."
          },
          {
            "1.3": "3. Binder Preparation",
            "Sift Magnesium stearate through 60# sieve & keep aside for lubrication stage.": ""
          },
          {
            "1.3": "3.1",
            "Sift Magnesium stearate through 60# sieve & keep aside for lubrication stage.": "Check the cleanliness of the solution preparation vessel."
          },
          {
            "1.3": "3.2",
            "Sift Magnesium stearate through 60# sieve & keep aside for lubrication stage.": "Take 1.6656 Kg purified water in binder preparation vessel then add slowly hypromellose HPMC 3mpas with continuous stirring to form a clear solution."
          },
          {
            "1.3": "4. Granulation:",
            "Sift Magnesium stearate through 60# sieve & keep aside for lubrication stage.": ""
          },
          {
            "1.3": "4.1",
            "Sift Magnesium stearate through 60# sieve & keep aside for lubrication stage.": "Add the binder solution slowly into RMG at impeller slow speed mix for 1 minutes followed by racking."
          },
          {
            "1.3": "4.2",
            "Sift Magnesium stearate through 60# sieve & keep aside for lubrication stage.": "If required add 0.7992 kg of purified water in RMG at impeller slow speed mix for 1 minute follwed by racking."
          },
          {
            "1.3": "4.3",
            "Sift Magnesium stearate through 60# sieve & keep aside for lubrication stage.": "Start the kneading by operating the impeller at Fast Speed for 30 seconds."
          },
          {
            "1.3": "4.4",
            "Sift Magnesium stearate through 60# sieve & keep aside for lubrication stage.": "Unload the material."
          },
          {
            "1.3": "5. Drying:",
            "Sift Magnesium stearate through 60# sieve & keep aside for lubrication stage.": ""
          },
          {
            "1.3": "5.1",
            "Sift Magnesium stearate through 60# sieve & keep aside for lubrication stage.": "Check the integrity of the dryer bowl before and after drying"
          },
