# ── Directory paths ────────────────────────────────────────────────────────
INPUT_DIR=input
OUTPUT_DIR=output

# ── OCR settings ───────────────────────────────────────────────────────────
OCR_ENABLED=true
OCR_LANGUAGE=en
OCR_DPI=300

# ── Table extraction strategy ─────────────────────────────────────────────
# Options: auto | pdfplumber | camelot | ocr
TABLE_STRATEGY=auto

# ── Figure filtering ───────────────────────────────────────────────────────
MIN_IMAGE_SIZE=1000        # Minimum image size in bytes (skip tiny images)
MIN_IMAGE_WIDTH=50         # Minimum width in pixels
MIN_IMAGE_HEIGHT=50        # Minimum height in pixels

# ── Font size thresholds ───────────────────────────────────────────────────
HEADER_FONT_SIZE_THRESHOLD=11.0   # pts — override for small-print docs

# ── Performance ────────────────────────────────────────────────────────────
MAX_WORKERS=4              # Parallel PDF processing workers

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
LOG_FILE=extraction.log
